from tkinter import *
import random

BEATS = {
    "Камень": "Ножницы",
    "Ножницы": "Бумага",
    "Бумага": "Камень",
}

EMOJI = {
    "Камень": "@",
    "Ножницы": "^",
    "Бумага": "#",
}


class RockPaperScissors(Frame):


    def _init_(self, root):
        super()._init_(root)
        self.root = root

        self.win = 0
        self.lose = 0
        self.draw = 0

        self.build_ui()

    # ПОСТРОЕНИЕ ИНТЕРФЕЙСА
    
    def build_ui(self):

        self.result_label = Label(
            self.root,
            text="Сделайте ход!",
            bg="#FFF",
            font=("Times New Roman", 20, "bold"),
            fg="#333"

        )
        self.result_label.place(x=0, y=15, width=430)

        self.comp_label = Label(
            self.root,
            text="Компьютер: -",
            bg="#FFF",
            font=("Times New Roman", 13),
            fg="#666"
        )
        self.comp_label.place(x=0, y=55, width=430)

        # КНОПКИ
        buttons = [("Камень", 10), ("Ножницы", 155), ("Бумага", 300)]
        for text, x in buttons:
            Button(
                self.root,
                text=f"{EMOJI[text]} {text}",
                font=("Times New Roman", 14),
                bg="#F0F0F0",
                activebackground="0055FF",
                command=lambda t=text: self.play(t)
            ).place(x=x, y=90, width=120, height=50)
        # КНОПКА СБРОСА СЧЁТА
        Button(
            self.root,
            text="Сбросить счёт",
            font=("Times New Roman", 10),
            command=self.reset_score
        ).place(x=300, y=150, width=120, height=25)

        # МЕТКА СО СЧЁТОМ
        self.score_label = Label(
            self.root,
            justify="left",
            font=("Times New Roman", 12),
            text=self.format_score(),
            bg="#FFF",
            fg="#222"
        )
        self.score_label.place(x=10, y=148)

        # ЛОГИКА РАУНЛА
    def play(self, player_choice):
        comp_choice = random.choice(list(BEATS.keys()))

        # ОПРЕДЕЛЕНИЕ РЕЗУЛЬТАТА
        if player_choice == comp_choice:
            self.draw += 1
            verdict = "Ничья!"
            color = "#888"

        elif BEATS[player_choice] == comp_choice:
            self.win += 1
            verdict = "Победа!!"
            color = "#2E8B57"

        else:
            self.lose += 1
            verdict = "Проигрыш..."
            color = "#C0392B"

        # ОБНОВЛЕНИЕ ИНТЕРФЕЙСА

        self.result_label.config(text=verdict, fg=color)

        self.comp_label.config(
            text=f"Компьютер: {EMOJI[comp_choice]} {comp_choice}"
        )

        self.score_label.config(text=self.format_score())

    # СБРОС И ФОРМАТИРОВАНИЕ
    
    def reset_score(self):
        self.win = self.lose = self.draw = 0

        self.result_label.config(text="Счёт сброшен. Сделайте ход!", fg="#333")
        self.comp_label.config(text="Компьютер: -")
        self.score_label.config(text=self.format_score())

